# Copia este archivo como .env y rellena los valores reales.
# .env NUNCA se sube a Git.

FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# Cadena aleatoria y larga. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto-por-una-cadena-aleatoria

# --- Base de datos ---
# Local (para probar sin Supabase):
DATABASE_URL=sqlite:///avant.db
#
# Supabase / PostgreSQL (usar el "Connection string" del pooler, modo Session):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Negocio ---
# Prefijo de los folios de nota de venta -> AVS-2026-0001
FOLIO_PREFIJO=AVS
